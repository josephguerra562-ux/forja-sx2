# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Scripts and build definitions are also consumed by Linux CI/WSL.
*.sh text eol=lf
*.py text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.yml text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.props text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Forja SX2 (2026-10-19): the language files (read on the PS4, any line end works) and their fonts.
*.lng text eol=lf
*.ttf binary
